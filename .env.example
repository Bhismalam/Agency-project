# Resend (https://resend.com) — used by app/api/contact/route.ts
RESEND_API_KEY= 
CONTACT_TO_EMAIL=

# Supabase (Project Settings → API Keys) — Fase 2 database, login & storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key bypasses row-level security. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Used only by `npm run db:seed`: the email the owner logs in with.
OWNER_EMAIL=
